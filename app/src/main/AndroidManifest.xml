<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Danbooru のタグ補完（プロンプトチップ）だけに使う（繋がらないときに使う端末内の辞書は、初回に dskjal.com から取得する）。生成そのものは端末内で完結する -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 取得の進み具合を通知に出す（前景サービス。アプリを閉じても、取得が続く） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Dragonspeedxl">
        <!-- HTP（FastRPC）の Stub が dlopen する CDSP 側ライブラリ。Android 12+ はマニフェストで宣言しないと見えない -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <uses-native-library android:name="libadsprpc.so" android:required="false" />
        <!-- GPU（QNN GPU バックエンド）で VAE を分担するのに必要 -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- テキストエンコーダ（CLIP）を動かす別プロセス。UNet とは DSP のセッションが別になる（ClipService.kt） -->
        <service
            android:name=".engine.ClipService"
            android:exported="false"
            android:process=":clip" />
        <!-- アプリのフォルダを「ファイル」アプリのサイドバーに出す（モデルの出し入れ・履歴画像の取り出し用） -->
        <provider
            android:name=".files.AppFilesProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!-- QR の写真の受け渡し。端末のカメラアプリに、キャッシュの qr/ だけを書き込ませる（アプリはカメラの権限を持たない） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
